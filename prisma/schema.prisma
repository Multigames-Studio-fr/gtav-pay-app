generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth required models ────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application models ───────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  discordId   String?  @unique
  name        String?
  email       String?  @unique
  image       String?
  isBanned    Boolean  @default(false)
  isWebmaster Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts        Account[]
  sessions        Session[]
  memberships     CompanyMember[]
  sentInvitations Invitation[]    @relation("InviteSender")
  invitations     Invitation[]    @relation("InviteReceiver")
  warnings        Warning[]
  absences        Absence[]
  bonuses         Bonus[]
}

model CompanyType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  procedures  String?  @db.Text
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companies Company[]
  roles     Role[]
}

model Company {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  typeId      String
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  type         CompanyType     @relation(fields: [typeId], references: [id])
  members      CompanyMember[]
  invitations  Invitation[]
  warnings     Warning[]
  absences     Absence[]
  salaryConfig SalaryConfig?
  truckPrices  TruckPrice[]
  bonuses      Bonus[]
}

model Role {
  id            String   @id @default(cuid())
  name          String
  color         String   @default("#6366f1")
  companyTypeId String
  permissions   Json     @default("[]")
  createdAt     DateTime @default(now())

  companyType CompanyType     @relation(fields: [companyTypeId], references: [id], onDelete: Cascade)
  members     CompanyMember[]
}

model CompanyMember {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  roleId    String?
  salary    Float    @default(0)
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role    Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, companyId])
}

model Invitation {
  id         String           @id @default(cuid())
  companyId  String
  senderId   String
  receiverId String
  status     InvitationStatus @default(PENDING)
  message    String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sender   User    @relation("InviteSender", fields: [senderId], references: [id])
  receiver User    @relation("InviteReceiver", fields: [receiverId], references: [id])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Warning {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  reason    String   @db.Text
  issuedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Absence {
  id        String    @id @default(cuid())
  userId    String
  companyId String
  startDate DateTime
  endDate   DateTime?
  reason    String?   @db.Text
  justified Boolean   @default(false)
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model SalaryConfig {
  id             String @id @default(cuid())
  companyId      String @unique
  taxRate        Float  @default(0.2)
  baseMultiplier Float  @default(1.0)
  payDay         Int    @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model TruckPrice {
  id           String  @id @default(cuid())
  companyId    String
  truckType    String
  pricePerFull Float
  capacity     Int     @default(1)
  description  String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, truckType])
}

model Bonus {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  amount    Float
  reason    String?  @db.Text
  awardedAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
